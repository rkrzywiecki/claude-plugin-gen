{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
{% for event, hook_list in by_event.items() %}
    "{{ event }}": [
{% for h in hook_list %}
      {
        "matcher": {{ h.matcher | tojson }},
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/{{ h.script }}",
            "timeout": {{ h.timeout }}
          }
        ],
        "description": {{ h.description | tojson }},
        "id": "{{ h.id }}"
      }{% if not loop.last %},{% endif %}

{% endfor %}
    ]{% if not loop.last %},{% endif %}

{% endfor %}
  }
}
